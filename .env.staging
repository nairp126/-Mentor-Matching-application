# Staging Environment Configuration
# Copy this file and update values for your staging environment

# Environment
NODE_ENV=staging

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mentor_platform_staging
DB_USER=mentor_user
DB_PASSWORD=your_staging_db_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_staging_redis_password

# JWT Configuration
JWT_SECRET=your_staging_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_staging_email@gmail.com
SMTP_PASS=your_staging_app_password

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# External API Configuration
TWILIO_ACCOUNT_SID=your_staging_twilio_sid
TWILIO_AUTH_TOKEN=your_staging_twilio_token
TWILIO_PHONE_NUMBER=your_staging_twilio_number

# Video Calling (WebRTC)
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVERS=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://staging.mentorplatform.com
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your_staging_session_secret_key
SESSION_MAX_AGE=86400000

# MFA Configuration
MFA_ISSUER=Mentor Platform Staging
MFA_WINDOW=2

# Notification Configuration
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_KEYS=10000

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000