# Production Environment Configuration
# IMPORTANT: Update all values before deploying to production

# Environment
NODE_ENV=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mentor_platform
DB_USER=mentor_user
DB_PASSWORD=CHANGE_THIS_PRODUCTION_DB_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PRODUCTION_REDIS_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_THIS_PRODUCTION_JWT_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@mentorplatform.com
SMTP_PASS=CHANGE_THIS_PRODUCTION_EMAIL_PASSWORD

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# External API Configuration
TWILIO_ACCOUNT_SID=CHANGE_THIS_PRODUCTION_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGE_THIS_PRODUCTION_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=CHANGE_THIS_PRODUCTION_TWILIO_NUMBER

# Video Calling (WebRTC)
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVERS=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Monitoring and Logging
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://mentorplatform.com
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=CHANGE_THIS_PRODUCTION_SESSION_SECRET_KEY
SESSION_MAX_AGE=86400000

# MFA Configuration
MFA_ISSUER=Mentor Platform
MFA_WINDOW=2

# Notification Configuration
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_KEYS=10000

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/mentorplatform.crt
SSL_KEY_PATH=/etc/ssl/private/mentorplatform.key

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=mentor-platform-backups

# Monitoring Configuration
SENTRY_DSN=CHANGE_THIS_SENTRY_DSN
NEW_RELIC_LICENSE_KEY=CHANGE_THIS_NEW_RELIC_KEY
DATADOG_API_KEY=CHANGE_THIS_DATADOG_KEY