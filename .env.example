# Database Configuration
DATABASE_URL=postgresql://mentor_user:mentor_password@localhost:5432/mentor_platform
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Service URLs (for API Gateway)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
SESSION_SERVICE_URL=http://localhost:3003
MATCHING_SERVICE_URL=http://localhost:3004
COMMUNICATION_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email Service (for notifications)
EMAIL_SERVICE_API_KEY=your-email-service-api-key
EMAIL_FROM_ADDRESS=noreply@mentorplatform.com

# SMS Service (for notifications)
SMS_SERVICE_API_KEY=your-sms-service-api-key

# External Services
VIDEO_CALL_SERVICE_API_KEY=your-video-service-api-key

# Development Settings
NODE_ENV=development
LOG_LEVEL=debug